# ==============================================================================
# DHH Pulse — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.

# Runtime environment ('development' | 'production' | 'test')
# In 'development', better-sqlite3 logs all queries with execution timings to stdout.
NODE_ENV=development

# Port for Next.js HTTP server (default: 3000)
PORT=3000

# Optional: Scrape Trigger Authentication Secret
# When configured, calls to POST /api/scrape must supply this token via:
#   - Header: 'x-scrape-token: <token>'
#   - Header: 'Authorization: Bearer <token>'
# When left unset, the endpoint allows open local/same-origin execution.
SCRAPE_TRIGGER_TOKEN=
